# Copia a .env y rellena. Todo VITE_* se inyecta en build y es PÚBLICO: nunca pongas service keys.
# En Railway, define estas mismas variables como variables de build.

VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. "G-XXXX" = Google Analytics 4; un dominio (p. ej. cocinarte.mx) = Plausible. Vacío = sin analítica.
VITE_PUBLIC_ANALYTICS_ID=

# Opcional. Número de WhatsApp Business, solo dígitos con lada de país (p. ej. 52 + 10 dígitos).
# Si está definido, gana sobre el número que guarda staff en /staff. Vacío = usa el de staff.
VITE_PUBLIC_WHATSAPP_E164=
